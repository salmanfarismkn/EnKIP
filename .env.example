DATABASE_URL=postgresql+psycopg://<POSTGRES_USER>:<POSTGRES_PASSWORD>@localhost:5432/<POSTGRES_DB>
STORAGE_ROOT=<local-storage-directory>
EMBEDDING_MODEL=<ollama-embedding-model-tag>
EMBEDDING_DIMENSIONS=<dimension-matching-current-schema-1024>
GENERATION_MODEL=<ollama-chat-model-tag>
QUERY_DECOMPOSITION_ENABLED=<true-or-false>
DECOMPOSITION_MODEL=<ollama-chat-model-tag>
OLLAMA_BASE_URL=<ollama-base-url>
