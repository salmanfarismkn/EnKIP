DATABASE_URL=postgresql+psycopg://<POSTGRES_USER>:<POSTGRES_PASSWORD>@localhost:5432/<POSTGRES_DB>
STORAGE_ROOT=<local-storage-directory>
# Maximum accepted document upload size (25 MiB by default).
MAX_UPLOAD_BYTES=26214400
# Worker/source and chunk bounds (must not be smaller than the upload limit if oversized records must remain processable).
MAX_INGESTION_SOURCE_BYTES=26214400
MAX_INGESTION_CHUNKS=10000
MAX_PDF_PAGES=1000
EMBEDDING_MODEL=<ollama-embedding-model-tag>
EMBEDDING_DIMENSIONS=<dimension-matching-current-schema-1024>
GENERATION_MODEL=<ollama-chat-model-tag>
QUERY_DECOMPOSITION_ENABLED=<true-or-false>
DECOMPOSITION_MODEL=<ollama-chat-model-tag>
OLLAMA_BASE_URL=<ollama-base-url>
APP_ENV=development
AUTH_MODE=oidc
OIDC_ISSUER=<trusted-issuer-url>
OIDC_AUDIENCE=<api-audience>
OIDC_JWKS_URI=<trusted-jwks-url>
OIDC_ALGORITHMS=RS256
OIDC_JWKS_CACHE_TTL_SECONDS=300
OIDC_REQUIRED_CLAIMS=
# Development only: UUID of an existing internal user. Never set in production.
ENKIP_DEV_USER_ID=
